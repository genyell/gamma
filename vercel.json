{
  "rewrites": [
    { "source": "/commander_online_beta.html", "destination": "/commander_online_beta.html" },
    { "source": "/commander.html", "destination": "/commander_online_beta.html" },
    { "source": "/(.*)", "destination": "/KEURGOUMAK_beta.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
